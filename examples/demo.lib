library (demo_nldm) {
  time_unit : "1ns";
  capacitive_load_unit (1,pf);
  cell (NAND2_X1) {
    pin (A) { direction : input; capacitance : 0.010; }
    pin (B) { direction : input; capacitance : 0.010; }
    pin (Y) {
      direction : output;
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0360, 0.0610", \
      "0.0540, 0.0860");
        }
        cell_fall (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0400, 0.0650", \
      "0.0580, 0.0900");
        }
        rise_transition (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0300, 0.0550", \
      "0.0480, 0.0800");
        }
        fall_transition (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0320, 0.0570", \
      "0.0500, 0.0820");
        }
      }
      timing () {
        related_pin : "B";
        timing_sense : negative_unate;
        cell_rise (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0360, 0.0610", \
      "0.0540, 0.0860");
        }
        cell_fall (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0400, 0.0650", \
      "0.0580, 0.0900");
        }
        rise_transition (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0300, 0.0550", \
      "0.0480, 0.0800");
        }
        fall_transition (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0320, 0.0570", \
      "0.0500, 0.0820");
        }
      }
    }
  }
  cell (INV_X1) {
    pin (A) { direction : input; capacitance : 0.010; }
    pin (Y) {
      direction : output;
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0250, 0.0500", \
      "0.0430, 0.0750");
        }
        cell_fall (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0290, 0.0540", \
      "0.0470, 0.0790");
        }
        rise_transition (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0190, 0.0440", \
      "0.0370, 0.0690");
        }
        fall_transition (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0210, 0.0460", \
      "0.0390, 0.0710");
        }
      }
    }
  }
  cell (BUF_X1) {
    pin (A) { direction : input; capacitance : 0.010; }
    pin (Y) {
      direction : output;
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0180, 0.0430", \
      "0.0360, 0.0680");
        }
        cell_fall (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0220, 0.0470", \
      "0.0400, 0.0720");
        }
        rise_transition (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0120, 0.0370", \
      "0.0300, 0.0620");
        }
        fall_transition (delay_2d) {
          index_1 ("0.020, 0.100");
          index_2 ("0.010, 0.100");
          values ("0.0140, 0.0390", \
      "0.0320, 0.0640");
        }
      }
    }
  }
}
